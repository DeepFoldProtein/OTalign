# Local environment for the ECOD30 / HHsuite pipeline.
# Copy to `.env` and edit. `.env` is gitignored.
#
# Shell consumers (scripts/submit_ecod30_hhblits.sh, scripts/slurm_hhblits_hhmake_array.sh)
# source this file via `set -a; source .env; set +a`.
# Python consumers read os.environ.

# ── HHsuite database (prefix without _a3m / _cs219 suffixes) ──
HHDB=/path/to/uniref30/UniRef30_2023_02

# ── Singularity / Apptainer image with hhblits, hhmake, hhalign ──
HHSUITE_SIF=/path/to/hhsuite.sif

# Comma-separated bind mounts for the container (host paths that must be
# visible inside, e.g. the DB root, project root, scratch).
SING_BINDS=/path/to/db,/path/to/project

# ── Optional: per-domain artefact layout (defaults match prepare script) ──
# FASTA_DIR=data/hhsuite/ecod30_hard/fasta
# A3M_DIR=data/hhsuite/ecod30_hard/a3m
# HHM_DIR=data/hhsuite/ecod30_hard/hhm
# FILELIST=data/hhsuite/ecod30_hard/fasta.list
